{
  "name": "@astra-conductor/polyquota",
  "version": "0.5.0",
  "private": true,
  "description": "PolyQuota desktop application",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "icons:generate": "node ./scripts/run-icon-generator.mjs",
    "native:prepare": "node ./scripts/prepare-native.mjs",
    "prebuild": "pnpm run native:prepare",
    "build:main": "tsc -p tsconfig.build.json && node ./scripts/clean-legacy-output.mjs",
    "dev:electron": "node ./scripts/run-electron-mode.mjs dev",
    "build": "pnpm run build:main && node ./scripts/copy-renderer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "node ./scripts/package.mjs",
    "data:reset": "node ./scripts/run-electron-mode.mjs reset",
    "test:codex-cli": "node ./scripts/run-electron-mode.mjs codex-cli-smoke",
    "dev:server": "node scripts/run-node-mode.mjs",
    "test:server": "vitest run test/service-mode-server.test.ts test/callback-server.test.ts test/browser-auth-roundtrip.test.ts test/node-http.test.ts",
    "test:protocol": "node scripts/run-protocol-smoke.mjs",
    "test:desktop": "node ./scripts/run-electron-mode.mjs desktop-smoke",
    "test:distribution": "node scripts/run-distribution-smoke.mjs"
  },
  "dependencies": {
    "@astra-conductor/core": "workspace:*",
    "@astra-conductor/polyquota-contract": "workspace:*",
    "@hono/node-server": "^1.19.17",
    "better-sqlite3": "catalog:",
    "hono": "^4.13.13",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@electron/rebuild": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
