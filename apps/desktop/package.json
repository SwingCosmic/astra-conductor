{
  "name": "@llm-usage/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Local desktop view of LLM subscription usage",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "native:prepare": "node ./scripts/prepare-native.mjs",
    "prebuild": "pnpm run native:prepare",
    "build:main": "tsc -p tsconfig.build.json && node ./scripts/copy-preload.mjs",
    "dev:electron": "node ./scripts/run-electron-mode.mjs dev",
    "build": "pnpm run build:main && node ./scripts/copy-renderer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "node ./scripts/package.mjs",
    "data:reset": "node ./scripts/run-electron-mode.mjs reset",
    "test:codex-cli": "node ./scripts/run-electron-mode.mjs codex-cli-smoke"
  },
  "dependencies": {
    "@llm-usage/core": "workspace:*",
    "better-sqlite3": "catalog:"
  },
  "devDependencies": {
    "@electron/rebuild": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
